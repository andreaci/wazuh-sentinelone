{
  "Logging": { "LogLevel": { "Default": "Information", "System.Net.Http": "Warning" } },

  "SentinelOne": {
    "BaseUrl": "https://YOURTENANT.sentinelone.net",
    "ApiToken": "",
    "AccountIds": [],
    "SiteIds": [],
    "PageSize": 1000
  },

  "Output": {
    "Directory": "/var/ossec/logs/sentinelone",
    "MaxFileSizeMb": 50,
    "RetainedFiles": 5
  },

  "State": { "Directory": "/var/lib/s1wazuh" },

  "Sources": {
    "Threats": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "InitialLookbackHours": 24,
      "Path": "/web/api/v2.1/threats",
      "TimeFilterParam": "updatedAt__gte",
      "SortBy": "updatedAt",
      "IdPath": "id",
      "TimestampPath": "threatInfo.updatedAt"
    },
    "Alerts": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "InitialLookbackHours": 24,
      "ViewType": "ALL",
      "TimeField": "updatedAt"
    },
    "Activities": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "InitialLookbackHours": 24,
      "Path": "/web/api/v2.1/activities",
      "TimeFilterParam": "createdAt__gte",
      "SortBy": "createdAt",
      "IdPath": "id",
      "TimestampPath": "createdAt"
    },
    "Agents": {
      "Enabled": true,
      "IntervalSeconds": 3600,
      "Path": "/web/api/v2.1/agents",
      "TimeFilterParam": null,
      "SortBy": null,
      "IdPath": "id",
      "TimestampPath": "updatedAt"
    },
    "DeepVisibility": {
      "Enabled": false,
      "IntervalSeconds": 300,
      "InitialLookbackHours": 1,
      "Query": "EventType = \"Process Creation\"",
      "MaxEventsPerQuery": 20000,
      "MaxWindowHours": 1
    }
  }
}
